<script>
  // Setup user menu dropdown toggle & keyboard accessibility
  const trigger = document.getElementById('user-menu-trigger');
  const dropdown = document.getElementById('user-dropdown');
  const chevron = document.getElementById('user-chevron');

  if (trigger && dropdown) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = dropdown.classList.contains('hidden');
      if (isHidden) {
        dropdown.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      } else {
        dropdown.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    });
  }

  // Setup operations & governance dropdown toggle & keyboard accessibility
  const govTrigger = document.getElementById('governance-menu-trigger');
  const govDropdown = document.getElementById('governance-dropdown');
  const govChevron = document.getElementById('governance-chevron');

  if (govTrigger && govDropdown) {
    govTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close user dropdown if open
      if (dropdown && !dropdown.classList.contains('hidden')) {
        dropdown.classList.add('hidden');
        trigger?.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }

      const isHidden = govDropdown.classList.contains('hidden');
      if (isHidden) {
        govDropdown.classList.remove('hidden');
        govTrigger.setAttribute('aria-expanded', 'true');
        govChevron?.classList.add('rotate-180');
      } else {
        govDropdown.classList.add('hidden');
        govTrigger.setAttribute('aria-expanded', 'false');
        govChevron?.classList.remove('rotate-180');
      }
    });

    document.addEventListener('click', (e) => {
      if (!govDropdown.contains(e.target as Node) && !govTrigger.contains(e.target as Node)) {
        govDropdown.classList.add('hidden');
        govTrigger.setAttribute('aria-expanded', 'false');
        govChevron?.classList.remove('rotate-180');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        govDropdown.classList.add('hidden');
        govTrigger.setAttribute('aria-expanded', 'false');
        govChevron?.classList.remove('rotate-180');
      }
    });
  }

  // Setup mobile nav toggle
  const mobileToggle = document.getElementById('mobile-nav-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');

  if (mobileToggle && mobilePanel) {
    mobileToggle.addEventListener('click', () => {
      mobilePanel.classList.toggle('hidden');
    });
  }
</script>
