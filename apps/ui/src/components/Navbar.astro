---
import {
  Layers,
  Gauge,
  Package,
  GitBranch,
  ShieldCheck,
  Plus,
  LogOut,
  ChevronDown,
  Menu,
  X,
  Sparkles,
  Server,
  Activity,
  Terminal,
  Bot,
  Sliders,
  History,
  PackageCheck,
} from 'lucide-react';

const pathname = Astro.url.pathname;
const user = Astro.locals.user;
const isAdmin = user?.role === 'admin';
const isDeveloper = user?.role === 'developers' || user?.role === 'developer';
const canCreate = isAdmin || isDeveloper;

// Navigation active states
const isClustersActive = pathname === '/' || pathname.startsWith('/clusters');
const isCapacityActive = pathname.startsWith('/capacity');
const isAppsActive = pathname.startsWith('/apps');
const isRegistryActive = pathname.startsWith('/registry');
const isAuditActive = pathname === '/audit' || pathname.startsWith('/audit') || pathname.startsWith('/admin/audit');
const isBundlesActive = pathname.startsWith('/bundles') || pathname.startsWith('/admin/bundles');
const isVersionsActive = pathname.startsWith('/admin/versions');
const isOidcActive = pathname.startsWith('/admin/oidc');
const isAiActive = pathname.startsWith('/admin/ai');
const isBaselinesActive = pathname.startsWith('/admin/baselines');
const isProvisionActive = pathname.startsWith('/new');
const isDocsActive = pathname.startsWith('/docs');

// Governance & Operations Unified State
const isGovernanceActive = isAuditActive || isBundlesActive || isVersionsActive || isOidcActive || isBaselinesActive || isAiActive;
let activeGovernanceLabel = '';
if (isBundlesActive) activeGovernanceLabel = 'Airgap Bundles';
else if (isAuditActive) activeGovernanceLabel = 'Audit Trail';
else if (isBaselinesActive) activeGovernanceLabel = 'Baselines';
else if (isOidcActive) activeGovernanceLabel = 'Access & OIDC';
else if (isVersionsActive) activeGovernanceLabel = 'Versions';
else if (isAiActive) activeGovernanceLabel = 'AI Engine';

// Breadcrumb resolution
let currentSection = 'Fleet Overview';
let clusterParam: string | null = null;

if (pathname.startsWith('/clusters/')) {
  currentSection = 'Fleet';
  const parts = pathname.replace('/clusters/', '').split('/');
  clusterParam = decodeURIComponent(parts[0]);
} else if (isCapacityActive) {
  currentSection = 'Capacity & Headroom';
} else if (isAppsActive) {
  currentSection = 'App Catalog';
} else if (isRegistryActive) {
  currentSection = 'OCI Artifact Registry';
} else if (isAuditActive) {
  currentSection = 'Audit Trail';
} else if (isBundlesActive) {
  currentSection = 'Airgap Bundles';
} else if (isVersionsActive) {
  currentSection = 'Version Registry';
} else if (isOidcActive) {
  currentSection = 'Access & Identity';
} else if (isAiActive) {
  currentSection = 'AI Engine & Models';
} else if (isBaselinesActive) {
  currentSection = 'Cluster Baselines';
} else if (isProvisionActive) {
  currentSection = 'Provision Cluster';
} else if (isDocsActive) {
  currentSection = 'Documentation';
}
---

<header class="sticky top-0 z-40 w-full border-b border-cyber-800/80 bg-cyber-950/90 backdrop-blur-xl transition-all">
  <!-- Top Primary Header (Height: 56px) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
    <!-- Left: Brand & Context Breadcrumb -->
    <div class="flex items-center gap-3.5 min-w-0">
      <a href="/" class="flex items-center gap-2.5 group shrink-0" title="vCluster Operations Center">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-400 via-cyan-500 to-blue-600 flex items-center justify-center text-slate-950 font-black font-mono shadow-[0_0_15px_rgba(6,182,212,0.4)] group-hover:shadow-[0_0_20px_rgba(6,182,212,0.6)] group-hover:scale-105 transition-all">
          <span class="text-xs tracking-tighter">vC</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold tracking-tight text-white group-hover:text-cyan-300 transition-colors">
            vCOp
          </span>
        </div>
      </a>

      <!-- Breadcrumbs divider -->
      <span class="text-cyber-700 font-mono text-sm select-none shrink-0">/</span>

      <!-- Active Section Breadcrumb -->
      <div class="flex items-center gap-1.5 text-xs font-mono truncate">
        <a href={isClustersActive ? '/' : pathname} class="text-slate-300 hover:text-white font-medium transition-colors truncate">
          {currentSection}
        </a>
        {clusterParam && (
          <>
            <span class="text-cyber-700 font-mono select-none">/</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-semibold text-cyan-300 bg-cyan-950/60 border border-cyan-800/80 shadow-[0_0_10px_rgba(6,182,212,0.15)] truncate">
              {clusterParam}
            </span>
          </>
        )}
      </div>
    </div>

    <!-- Right: Telemetry Status, Quick Action & User Profile -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Operator Health Pulse (Compact 2026 indicator) -->
      <div class="hidden md:flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyber-900/60 border border-cyber-800/80 text-xs font-mono" title="vCOp Operator running healthy on host Kubernetes cluster">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_8px_rgba(160,185,129,0.6)]"></span>
        </span>
        <span class="text-slate-400 text-[11px]">Operator</span>
        <span class="text-emerald-400 font-semibold text-[11px]">Active</span>
      </div>

      <!-- Quick Action: New Cluster Button (Admins and Developers) -->
      {canCreate && (
        <a
          href="/new"
          class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs transition-all font-mono ${
            isProvisionActive
              ? 'bg-cyan-300 text-slate-950 shadow-[0_0_20px_rgba(6,182,212,0.6)] ring-2 ring-cyan-400'
              : 'bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 shadow-[0_0_14px_rgba(6,182,212,0.3)] hover:shadow-[0_0_20px_rgba(6,182,212,0.5)]'
          }`}
        >
          <Plus class="w-3.5 h-3.5 stroke-[2.5]" />
          <span class="hidden sm:inline">New Cluster</span>
        </a>
      )}

      <!-- User Profile Dropdown / Popover -->
      {user ? (
        <div class="relative" id="user-menu-root">
          <button
            id="user-menu-trigger"
            type="button"
            class="flex items-center gap-2 p-1 pl-1.5 pr-2 rounded-xl bg-cyber-900/80 hover:bg-cyber-800/90 border border-cyber-700/80 hover:border-cyber-600 transition-all text-xs font-mono cursor-pointer focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <!-- Avatar Initials -->
            <div class={`w-6 h-6 rounded-lg flex items-center justify-center text-[10px] font-bold uppercase transition-all ${
              isAdmin
                ? 'bg-purple-500/20 text-purple-300 border border-purple-500/40 shadow-[0_0_10px_rgba(168,85,247,0.25)]'
                : isDeveloper
                ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-[0_0_10px_rgba(245,158,11,0.25)]'
                : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-[0_0_10px_rgba(6,182,212,0.25)]'
            }`}>
              {user.username.slice(0, 2)}
            </div>
            <span class="text-slate-200 text-xs font-medium max-w-[100px] truncate hidden sm:inline">
              {user.username}
            </span>
            <ChevronDown class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" id="user-chevron" />
          </button>

          <!-- Floating Glassmorphism Popover Menu -->
          <div
            id="user-dropdown"
            class="hidden absolute right-0 mt-2 w-64 rounded-2xl bg-cyber-950/95 backdrop-blur-2xl border border-cyber-700/80 shadow-2xl p-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150"
          >
            <!-- Header Identity -->
            <div class="px-3 py-2.5 border-b border-cyber-800/80">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-white truncate">{user.name || user.username}</span>
                <span class={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold uppercase tracking-wider ${
                  isAdmin
                    ? 'bg-purple-500/20 text-purple-300 border border-purple-500/40'
                    : isDeveloper
                    ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                    : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'
                }`}>
                  {isAdmin ? 'Admin' : isDeveloper ? 'Developer' : 'Viewer'}
                </span>
              </div>
              <p class="text-[11px] font-mono text-slate-400 truncate mt-0.5">{user.email || `${user.username}@cluster.local`}</p>
              <div class="mt-2 flex items-center justify-between text-[10px] font-mono text-slate-500">
                <span>Auth Provider:</span>
                <span class="text-slate-300 capitalize">{user.method === 'oidc' ? 'Enterprise SSO' : 'Breakglass Local'}</span>
              </div>
              {user.groups && user.groups.length > 0 && (
                <div class="mt-2 pt-2 border-t border-cyber-900 flex flex-wrap gap-1">
                  <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider block w-full">Assigned Groups:</span>
                  {user.groups.slice(0, 4).map((grp: string) => (
                    <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-cyber-900 border border-cyber-800 text-cyan-300 truncate max-w-[180px]">
                      {grp}
                    </span>
                  ))}
                  {user.groups.length > 4 && (
                    <span class="text-[9px] font-mono text-slate-500 self-center">
                      +{user.groups.length - 4} more
                    </span>
                  )}
                </div>
              )}
            </div>

            <!-- Quick Navigation -->
            <div class="py-1">
              <a
                href="/"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
              >
                <Layers class="w-3.5 h-3.5 text-slate-400" />
                <span>Fleet Clusters</span>
              </a>
              <a
                href="/capacity"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
              >
                <Gauge class="w-3.5 h-3.5 text-slate-400" />
                <span>Capacity Analytics</span>
              </a>
              <a
                href="/apps"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
              >
                <Package class="w-3.5 h-3.5 text-slate-400" />
                <span>App Store</span>
              </a>
              <a
                href="/registry"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
              >
                <Server class="w-3.5 h-3.5 text-slate-400" />
                <span>OCI Registry</span>
              </a>
              <a
                href="/audit"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
              >
                <History class="w-3.5 h-3.5 text-cyan-400" />
                <span>Audit Trail</span>
              </a>
              {isAdmin && (
                <a
                  href="/bundles"
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
                >
                  <PackageCheck class="w-3.5 h-3.5 text-cyan-400" />
                  <span>Airgap Bundles</span>
                </a>
              )}
              {isAdmin && (
                <a
                  href="/admin/versions"
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
                >
                  <GitBranch class="w-3.5 h-3.5 text-slate-400" />
                  <span>Version Registry</span>
                </a>
              )}
              {isAdmin && (
                <a
                  href="/admin/oidc"
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
                >
                  <ShieldCheck class="w-3.5 h-3.5 text-slate-400" />
                  <span>OIDC Policies</span>
                </a>
              )}
              {isAdmin && (
                <a
                  href="/admin/baselines"
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
                >
                  <Sliders class="w-3.5 h-3.5 text-slate-400" />
                  <span>Cluster Baselines</span>
                </a>
              )}
              {isAdmin && (
                <a
                  href="/admin/ai"
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-slate-300 hover:text-white hover:bg-cyber-900 rounded-xl transition-colors font-mono"
                >
                  <Bot class="w-3.5 h-3.5 text-slate-400" />
                  <span>AI Engine & Models</span>
                </a>
              )}
            </div>

            <!-- Sign Out -->
            <div class="pt-1 border-t border-cyber-800/80">
              <a
                href="/api/auth/logout"
                class="flex items-center gap-2.5 px-3 py-2 text-xs text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 rounded-xl transition-colors font-mono font-medium"
              >
                <LogOut class="w-3.5 h-3.5 text-rose-400" />
                <span>Sign Out</span>
              </a>
            </div>
          </div>
        </div>
      ) : (
        <a
          href="/login"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-cyber-800 hover:bg-cyber-700 text-slate-200 font-semibold text-xs rounded-xl border border-cyber-700 transition-all font-mono"
        >
          Sign In
        </a>
      )}

      <!-- Mobile Hamburger Toggle -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="md:hidden p-1.5 text-slate-400 hover:text-white bg-cyber-900 border border-cyber-800 rounded-xl transition-colors"
        aria-label="Toggle navigation menu"
      >
        <Menu class="w-4 h-4" id="mobile-menu-icon" />
      </button>
    </div>
  </div>

  <!-- Sub-Header Navigation Bar (Fluid Horizontal Flow) -->
  <div class="border-t border-cyber-800/60 bg-cyber-950/60 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center flex-wrap gap-1 py-1 text-xs overflow-x-hidden">
        <!-- Fleet Clusters -->
        <a
          href="/"
          class={`group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap font-mono ${
            isClustersActive
              ? 'bg-cyan-500/10 text-cyan-300 font-semibold border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
              : 'text-slate-400 hover:text-slate-200 hover:bg-cyber-900/60 border border-transparent'
          }`}
        >
          <Layers class={`w-3.5 h-3.5 transition-colors ${isClustersActive ? 'text-cyan-400' : 'text-slate-500 group-hover:text-slate-300'}`} />
          <span>Fleet Clusters</span>
        </a>

        <!-- Capacity & Headroom -->
        <a
          href="/capacity"
          class={`group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap font-mono ${
            isCapacityActive
              ? 'bg-cyan-500/10 text-cyan-300 font-semibold border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
              : 'text-slate-400 hover:text-slate-200 hover:bg-cyber-900/60 border border-transparent'
          }`}
        >
          <Gauge class={`w-3.5 h-3.5 transition-colors ${isCapacityActive ? 'text-cyan-400' : 'text-slate-500 group-hover:text-slate-300'}`} />
          <span>Capacity & Headroom</span>
        </a>

        <!-- App Catalog -->
        <a
          href="/apps"
          class={`group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap font-mono ${
            isAppsActive
              ? 'bg-cyan-500/10 text-cyan-300 font-semibold border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
              : 'text-slate-400 hover:text-slate-200 hover:bg-cyber-900/60 border border-transparent'
          }`}
        >
          <Package class={`w-3.5 h-3.5 transition-colors ${isAppsActive ? 'text-cyan-400' : 'text-slate-500 group-hover:text-slate-300'}`} />
          <span>App Catalog</span>
        </a>

        <!-- OCI Registry (Harbor-style Artifact & Chart Store) -->
        <a
          href="/registry"
          class={`group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap font-mono ${
            isRegistryActive
              ? 'bg-cyan-500/10 text-cyan-300 font-semibold border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
              : 'text-slate-400 hover:text-slate-200 hover:bg-cyber-900/60 border border-transparent'
          }`}
        >
          <Server class={`w-3.5 h-3.5 transition-colors ${isRegistryActive ? 'text-cyan-400' : 'text-slate-500 group-hover:text-slate-300'}`} />
          <span>OCI Registry</span>
        </a>

        <!-- Divider -->
        <div class="h-4 w-px bg-cyber-800/80 my-auto mx-1.5"></div>

        <!-- Operations & Governance Dropdown (Minimalist 2026 UX) -->
        <div class="relative" id="governance-menu-root">
          <button
            id="governance-menu-trigger"
            type="button"
            class={`group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap font-mono text-xs cursor-pointer border ${
              isGovernanceActive
                ? 'bg-cyan-500/10 text-cyan-300 font-semibold border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.15)]'
                : 'text-slate-400 hover:text-slate-200 hover:bg-cyber-900/60 border-transparent'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <Sliders class={`w-3.5 h-3.5 transition-colors ${isGovernanceActive ? 'text-cyan-400' : 'text-slate-500 group-hover:text-slate-300'}`} />
            <span>Operations & Governance</span>
            {isGovernanceActive && (
              <span class="px-1.5 py-0.2 text-[10px] font-mono font-bold uppercase rounded bg-cyan-950 border border-cyan-800 text-cyan-300 ml-0.5 hidden sm:inline">
                {activeGovernanceLabel}
              </span>
            )}
            <ChevronDown class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" id="governance-chevron" />
          </button>

          <!-- Glassmorphic Dropdown Popover -->
          <div
            id="governance-dropdown"
            class="hidden absolute left-0 mt-2 w-80 rounded-2xl bg-cyber-950/98 backdrop-blur-2xl border border-cyber-700/80 shadow-2xl p-2.5 z-50 animate-in fade-in slide-in-from-top-2 duration-150 divide-y divide-cyber-800/80 font-mono"
          >
            <!-- Group 1: Supply Chain & Telemetry -->
            <div class="pb-2">
              <span class="px-2.5 py-1 text-[10px] uppercase tracking-wider text-slate-500 block font-semibold">
                Supply Chain & Telemetry
              </span>
              <div class="space-y-0.5 mt-1">
                <a
                  href="/bundles"
                  class={`flex items-center justify-between p-2 rounded-xl transition-colors ${
                    isBundlesActive ? 'bg-cyan-500/10 text-cyan-300 border border-cyan-500/30' : 'text-slate-300 hover:text-white hover:bg-cyber-900/70'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="p-1.5 rounded-lg bg-cyan-500/15 border border-cyan-500/30 text-cyan-400 shrink-0">
                      <PackageCheck class="w-3.5 h-3.5" />
                    </div>
                    <div class="truncate">
                      <div class="font-semibold text-xs text-white">Airgap Bundles</div>
                      <div class="text-[10px] text-slate-400 truncate">Cross-domain transfers & SBOMs</div>
                    </div>
                  </div>
                  {isBundlesActive && <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>}
                </a>

                <a
                  href="/audit"
                  class={`flex items-center justify-between p-2 rounded-xl transition-colors ${
                    isAuditActive ? 'bg-cyan-500/10 text-cyan-300 border border-cyan-500/30' : 'text-slate-300 hover:text-white hover:bg-cyber-900/70'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="p-1.5 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-400 shrink-0">
                      <History class="w-3.5 h-3.5" />
                    </div>
                    <div class="truncate">
                      <div class="font-semibold text-xs text-white">Audit Trail</div>
                      <div class="text-[10px] text-slate-400 truncate">Immutable security event history</div>
                    </div>
                  </div>
                  {isAuditActive && <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>}
                </a>
              </div>
            </div>

            <!-- Group 2: Policy & Governance -->
            <div class="py-2">
              <span class="px-2.5 py-1 text-[10px] uppercase tracking-wider text-slate-500 block font-semibold">
                Policy & Governance
              </span>
              <div class="space-y-0.5 mt-1">
                <a
                  href="/admin/baselines"
                  class={`flex items-center justify-between p-2 rounded-xl transition-colors ${
                    isBaselinesActive ? 'bg-cyan-500/10 text-cyan-300 border border-cyan-500/30' : 'text-slate-300 hover:text-white hover:bg-cyber-900/70'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="p-1.5 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 shrink-0">
                      <Sliders class="w-3.5 h-3.5" />
                    </div>
                    <div class="truncate">
                      <div class="font-semibold text-xs text-white">Cluster Baselines</div>
                      <div class="text-[10px] text-slate-400 truncate">Sizing tiers, quotas & presets</div>
                    </div>
                  </div>
                  {isBaselinesActive && <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>}
                </a>

                <a
                  href="/admin/oidc"
                  class={`flex items-center justify-between p-2 rounded-xl transition-colors ${
                    isOidcActive ? 'bg-cyan-500/10 text-cyan-300 border border-cyan-500/30' : 'text-slate-300 hover:text-white hover:bg-cyber-900/70'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="p-1.5 rounded-lg bg-purple-500/15 border border-purple-500/30 text-purple-400 shrink-0">
