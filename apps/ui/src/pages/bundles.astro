---
import Layout from '../layouts/Layout.astro';
import { AirgapBundlesView } from '../components/AirgapBundlesView';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Airgap Bundles & Supply Chain - vCluster Operations Center">
  <div class="space-y-6">
    <AirgapBundlesView client:load />
  </div>
</Layout>
