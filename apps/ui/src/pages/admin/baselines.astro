---
import Layout from '../../layouts/Layout.astro';
import { BaselinesAndSizingContainer } from '../../components/BaselinesAndSizingContainer';
import { getClusterBaselines } from '../../lib/cluster-baselines';
import { getSizingTiers } from '../../lib/sizing-tiers';

const user = Astro.locals.user;
if (user && user.role !== 'admin') {
  return Astro.redirect('/?denied=admin_required');
}

const isAdmin = user?.role === 'admin';
const [baselines, sizingTiers] = await Promise.all([
  getClusterBaselines(),
  getSizingTiers(),
]);
---

<Layout title="Cluster Baselines & Sizing Tiers - vCluster Operations Center">
  <div class="space-y-6">
    <BaselinesAndSizingContainer
      client:load
      initialBaselines={baselines}
      initialSizingTiers={sizingTiers}
      isAdmin={isAdmin}
    />
  </div>
</Layout>
