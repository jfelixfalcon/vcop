---
import Layout from '../../layouts/Layout.astro';
import { AIManager } from '../../components/AIManager';

const user = Astro.locals.user;
if (user && user.role !== 'admin') {
  return Astro.redirect('/?denied=admin_required');
}

const isAdmin = user?.role === 'admin';
---

<Layout title="AI Engine & Remote Model Gateway - vCluster Operations Center">
  <div class="space-y-6">
    <AIManager client:load isAdmin={isAdmin} />
  </div>
</Layout>
