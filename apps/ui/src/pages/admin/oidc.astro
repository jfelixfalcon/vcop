---
import Layout from '../../layouts/Layout.astro';
import { AccessAndOidcContainer } from '../../components/AccessAndOidcContainer';
import { getOidcRegistry } from '../../lib/oidc-registry';

const user = Astro.locals.user;
if (user && user.role !== 'admin') {
  return Astro.redirect('/?denied=admin_required');
}

const isAdmin = user?.role === 'admin';
const registry = await getOidcRegistry();
---

<Layout title="Access Control & OIDC Identity - vCluster Operations Center">
  <div class="space-y-6">
    <AccessAndOidcContainer client:load initialRegistry={registry} isAdmin={isAdmin} />
  </div>
</Layout>
