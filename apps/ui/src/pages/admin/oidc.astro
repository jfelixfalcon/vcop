---
import Layout from '../../layouts/Layout.astro';
import { OidcManager } from '../../components/OidcManager';
import { getOidcRegistry } from '../../lib/oidc-registry';

const user = Astro.locals.user;
if (user && user.role !== 'admin') {
  return Astro.redirect('/?denied=admin_required');
}

const isAdmin = user?.role === 'admin';
const registry = await getOidcRegistry();
---

<Layout title="Global & Group OIDC Policy - vCluster Operations Center">
  <div class="space-y-6">
    <OidcManager client:load initialRegistry={registry} isAdmin={isAdmin} />
  </div>
</Layout>
