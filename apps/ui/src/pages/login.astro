---
import { getAuthConfig } from '../lib/auth';
import { Shield, KeyRound, Lock, User, AlertCircle, ArrowRight, Sparkles } from 'lucide-react';

const config = await getAuthConfig();
const error = Astro.url.searchParams.get('error');
const redirectUrl = Astro.url.searchParams.get('redirect') || '/';

const errorMessages: Record<string, string> = {
  invalid_credentials: 'The username or password you entered is incorrect.',
  missing_credentials: 'Please enter both username and password.',
  oidc_not_configured: 'OIDC Single Sign-On is not configured on this instance.',
  invalid_state: 'Security state verification failed during SSO callback. Please try again.',
  missing_authorization_code: 'No authorization code or token received from identity provider.',
  oidc_exchange_failed: 'Failed to exchange authorization code with identity provider.',
  token_verification_failed: 'Failed to verify token returned by identity provider.',
  token_authentication_failed: 'Token authentication failed. Please verify your identity provider credentials.',
};

const displayError = error ? (errorMessages[error] || decodeURIComponent(error)) : null;
---

<!doctype html>
<html lang="en" class="dark h-full bg-cyber-950 text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign In - vCluster Operations Center</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body class="min-h-full flex items-center justify-center p-4 bg-cyber-950 font-sans selection:bg-cyan-500/20 selection:text-cyan-300 relative overflow-hidden">
    <!-- Cybernetic Ambient Background Glows -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-b from-cyan-500/15 via-blue-600/10 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute bottom-10 -right-20 w-[500px] h-[500px] bg-purple-600/10 blur-3xl rounded-full"></div>
    </div>

    <!-- Login Container -->
    <div class="relative z-10 w-full max-w-md">
      <!-- Brand Header -->
      <div class="text-center mb-8">
        <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-400 to-blue-600 items-center justify-center text-slate-950 font-bold font-mono text-2xl shadow-glow-md mb-4">
          <span>vC</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center justify-center gap-2">
          vCluster Operations Center
        </h1>
        <p class="text-xs text-slate-400 mt-1 font-mono">
          Isolated Multi-Tenant Kubernetes Fleet Management
        </p>
      </div>

      <!-- Auth Card -->
      <div class="bg-cyber-900/90 border border-cyber-700/80 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
        <!-- Accent Top Line -->
        <div class="absolute top-0 left-1/4 right-1/4 h-[1px] bg-gradient-to-r from-transparent via-cyan-400 to-transparent"></div>

        {displayError && (
          <div class="mb-6 p-3.5 bg-rose-500/10 border border-rose-500/30 rounded-xl text-rose-400 text-xs flex items-start gap-2.5">
            <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
            <span class="leading-relaxed">{displayError}</span>
          </div>
        )}

        {/* OIDC Single Sign-On Button */}
        {config.oidc.enabled && (
          <div class="space-y-4 mb-6">
            <a
              href="/api/auth/oidc"
              class="w-full py-3 px-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs rounded-xl shadow-glow-sm flex items-center justify-center gap-2.5 transition-all group"
            >
              <Shield className="w-4 h-4 text-slate-950 group-hover:scale-110 transition-transform" />
              <span>Sign in with {config.oidc.providerName}</span>
              <ArrowRight className="w-4 h-4 ml-1 opacity-70 group-hover:translate-x-0.5 transition-transform" />
            </a>

            <div class="relative flex items-center justify-center">
              <div class="border-t border-cyber-800 w-full"></div>
              <span class="bg-cyber-900 px-3 text-[11px] font-mono text-slate-500 uppercase tracking-wider relative">
                or local credentials
              </span>
            </div>
          </div>
        )}

        <!-- Breakglass / Local Form -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-300 flex items-center gap-1.5 font-mono">
              <KeyRound className="w-3.5 h-3.5 text-cyber-accent" />
              Breakglass & Local Access
            </h2>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyber-800 text-cyan-400 border border-cyber-700">
              RBAC Enabled
            </span>
          </div>

          <form action="/api/auth/login" method="POST" class="space-y-4">
            <div>
              <label for="username" class="block text-xs font-medium text-slate-300 mb-1.5">
                Username or Account
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                  <User className="w-4 h-4" />
                </div>
                <input
                  type="text"
                  id="username"
                  name="username"
                  required
                  defaultValue="admin"
                  placeholder="e.g. admin or dev"
                  class="w-full pl-9 pr-3 py-2.5 bg-cyber-950/80 border border-cyber-700 rounded-xl text-xs text-white placeholder:text-slate-600 focus:outline-none focus:border-cyber-accent font-mono transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="password" class="block text-xs font-medium text-slate-300 mb-1.5">
                Password
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                  <Lock className="w-4 h-4" />
                </div>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  placeholder="••••••••••••"
                  class="w-full pl-9 pr-3 py-2.5 bg-cyber-950/80 border border-cyber-700 rounded-xl text-xs text-white placeholder:text-slate-600 focus:outline-none focus:border-cyber-accent font-mono transition-colors"
                />
              </div>
            </div>

            <button
              type="submit"
              class="w-full mt-2 py-2.5 px-4 bg-cyber-800 hover:bg-cyber-700 text-slate-200 hover:text-white font-medium text-xs rounded-xl border border-cyber-700 hover:border-cyber-600 transition-all flex items-center justify-center gap-2"
            >
              <span>Authenticate Session</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </button>
          </form>
        </div>

        <!-- Role Permissions Guide Card -->
        <div class="mt-6 pt-5 border-t border-cyber-800/80 space-y-2 text-[11px] font-mono text-slate-400">
          <p class="font-semibold text-slate-300">Access Roles & Capabilities:</p>
          <div class="grid grid-cols-1 gap-2 pt-1">
            <div class="p-2 rounded-lg bg-cyber-950/60 border border-cyber-800/60">
              <span class="text-cyan-400 font-bold">Admin:</span> Full control (provision, adjust quotas, sleep/wake, upgrade, teardown, get kubeconfig).
            </div>
            <div class="p-2 rounded-lg bg-cyber-950/60 border border-cyber-800/60">
              <span class="text-blue-400 font-bold">Viewer:</span> View owned/group clusters and download kubeconfig. Modifications blocked.
            </div>
          </div>
          <div class="pt-2 text-[10px] text-slate-500">
          </div>
        </div>
      </div>
    </div>

    <!-- Implicit Flow & Token Hash Fragment Detector -->
    <script is:inline>
      (function() {
        if (window.location.hash && window.location.hash.length > 1) {
          try {
            const params = new URLSearchParams(window.location.hash.substring(1));
            const accessToken = params.get('access_token') || params.get('token');
            const idToken = params.get('id_token');
            const code = params.get('code');
            const state = params.get('state');

            if (accessToken || idToken || code) {
              fetch('/api/auth/callback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ access_token: accessToken, id_token: idToken, code, state })
              }).then(function(res) {
                if (res.ok) {
                  window.location.href = '/';
                }
              }).catch(function() {});
            }
          } catch (e) {}
        }
      })();
    </script>
  </body>
</html>
